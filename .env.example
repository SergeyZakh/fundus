# Vorlage für die Umgebungsvariablen. python skripte/env-anlegen.py macht daraus die .env neben
# docker-compose.yml und setzt Zufallswerte für alle Platzhalter (.env ist in .gitignore).
# Echte Werte gehören in den Passwort-Manager, nie in dieses Repo.

# ---------- Adresse ----------
# Genau die Adresse, unter der das Wiki aufgerufen wird, ohne Schrägstrich am Ende.
APP_URL=https://wiki.firma.intern

# Ports auf dem Rechner, an die der Reverse Proxy (TLS) weiterleitet: APP_URL an WIKI_PORT, die
# draw.io-Adresse an DRAWIO_PORT. Die Vorgaben sind nur vom Rechner selbst erreichbar.
WIKI_PORT=127.0.0.1:6875
DRAWIO_PORT=127.0.0.1:6876

# Schlüssel für Sitzungen und verschlüsselte Daten (z. B. MFA). Einmal erzeugen:
#   docker run --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:26.05.4 appkey
# Nie ändern, solange Daten existieren; bei einer Wiederherstellung wird derselbe Wert gebraucht.
APP_KEY=base64:PLATZHALTER_APP_KEY

TZ=Europe/Berlin

# ---------- Datenbank ----------
DB_DATABASE=bookstack
DB_USERNAME=bookstack
# Mindestens 24 Zeichen; nur Buchstaben und Ziffern, dann gibt es keine Probleme mit Sonderzeichen in der .env.
DB_PASSWORD=PLATZHALTER_DB_PASSWORT

# ---------- Anmeldung ----------
# „standard“ nur für die Ersteinrichtung und als Notfallzugang, sonst „oidc“.
AUTH_METHOD=standard
# true: Die Anmeldeseite leitet sofort zum Anbieter weiter.
AUTH_AUTO_INITIATE=false
# Callback-Adresse, die beim Anbieter eingetragen wird: <APP_URL>/oidc/callback
# Ein Block je Anbieter; genau einen einkommentieren.

# --- Keycloak (docker-compose.keycloak.yml oder vorhandener Server) ---
# OIDC_NAME=Firmenkonto
# OIDC_ISSUER=https://anmeldung.firma.intern/realms/fundus
# OIDC_CLIENT_ID=wiki
# OIDC_CLIENT_SECRET=PLATZHALTER_CLIENT_SECRET

# --- Authentik (Provider „OAuth2/OpenID“, Anwendungs-Slug „wiki“) ---
# OIDC_NAME=Firmenkonto
# OIDC_ISSUER=https://authentik.firma.intern/application/o/wiki/
# OIDC_CLIENT_ID=PLATZHALTER_CLIENT_ID
# OIDC_CLIENT_SECRET=PLATZHALTER_CLIENT_SECRET
# Gruppen kommen bei Authentik über den Scope „profile“ im Claim „groups“.

# --- Entra ID (Microsoft 365) ---
# OIDC_NAME=Microsoft 365
# OIDC_ISSUER=https://login.microsoftonline.com/<Tenant-ID>/v2.0
# OIDC_CLIENT_ID=<Anwendungs-ID>
# OIDC_CLIENT_SECRET=PLATZHALTER_CLIENT_SECRET
# OIDC_EXTERNAL_ID_CLAIM=oid

# Berufstitel pflegen Admins im Wiki (Einstellungen → Benutzer → Person). Nur wenn sie stattdessen aus dem
# Anmeldedienst kommen sollen, hier den Claim nennen; dann überschreibt jede Anmeldung den Titel im Wiki.
# FUNDUS_TITEL_CLAIM=titel
# FUNDUS_STUFE_CLAIM=titel_stufe

# --- Nur für docker-compose.keycloak.yml ---
# Öffentliche Adresse von Keycloak; der Reverse Proxy leitet sie an KEYCLOAK_PORT weiter.
KEYCLOAK_URL=https://anmeldung.firma.intern
KEYCLOAK_PORT=127.0.0.1:8180
# Erstes Admin-Konto für die Keycloak-Oberfläche; danach dort ein persönliches Konto anlegen.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=PLATZHALTER_KEYCLOAK_ADMIN
KEYCLOAK_DB_PASSWORD=PLATZHALTER_KEYCLOAK_DB

# ---------- Diagramme (draw.io) ----------
# Eigene Adresse für den Dienst „drawio“ (im Reverse Proxy an DRAWIO_PORT). Die Parameter hinter „?“
# braucht BookStack für die Einbettung; offline=1 schaltet Cloud-Speicher ab.
DRAWIO_SERVER_URL=https://drawio.firma.intern/
DRAWIO_URL=https://drawio.firma.intern/?embed=1&proto=json&spin=1&configure=1&offline=1&lang=de
# Lokal (docker-compose.lokal.yml):
# DRAWIO_SERVER_URL=http://localhost:6876/
# DRAWIO_URL=http://localhost:6876/?embed=1&proto=json&spin=1&configure=1&offline=1&lang=de

# ---------- Werkzeuge auf der Startseite ----------
# Links zu eigenen Werkzeugen: „Name|Adresse|Beschreibung“, mehrere mit Semikolon getrennt.
# Leer lassen, dann kein Kasten „Werkzeuge“.
# FUNDUS_WERKZEUGE=Zeiterfassung|https://zeit.firma.intern|Arbeitszeit buchen; Tickets|https://tickets.firma.intern|Anfragen und Störungen
FUNDUS_WERKZEUGE=

# ---------- KI-Chat Fundus ----------
# Adresse des Ollama-Servers. Vorgabe ist der Dienst „ollama“ im Stapel; der Dienst „ollama-modelle“
# lädt KI_MODELL und KI_EINBETTUNG beim Start (zusammen rund 4 GB). Leer (OLLAMA_URL=): kein Chatfenster.
# Ein vorhandenes Ollama, z. B. auf einem Rechner mit Grafikkarte: http://ollama.firma.intern:11434,
# auf dem eigenen Rechner (docker-compose.lokal.yml): http://host.docker.internal:11434.
# KI_MODELL beantwortet Fragen, KI_EINBETTUNG macht aus Text Vektoren. KI_DIMENSION muss zur
# Vektorlänge des Einbettungsmodells passen (bge-m3: 1024); nach einem Wechsel den Index neu bauen.
OLLAMA_URL=http://ollama:11434
KI_MODELL=qwen3.5:4b
KI_EINBETTUNG=bge-m3
KI_DIMENSION=1024
# Treffergrenze der Suche (Kosinus-Abstand); nur ändern, wenn die KI zu wenig oder zu viel findet.
KI_MAX_ABSTAND=0.72

# Texterkennung für Anhänge und Bilder (Dienst „ocr“ im Stapel). Vorgabe http://ocr:8080; leer (OCR_URL=) schaltet sie ab.
# Vorhandene Anhänge und Bilder einmalig: php artisan fundus:datei-text (als abc, siehe Entwicklerdoku).
# OCR_URL=http://ocr:8080
# Konfidenz 0–100: Wörter darunter fallen weg, Scan-Seiten mit schlechterem Mittel ganz. Längere PDFs nur bis OCR_MAX_SEITEN.
OCR_WORT_MIN=50
OCR_SEITE_MIN=60
OCR_MAX_SEITEN=50

# ---------- Prüfung von Artikeln ----------
# Vorgabe in Monaten, bis ein Artikel erneut geprüft werden soll. Pro Thema oder Artikel über das
# Schlagwort „Prüfintervall“ änderbar (z. B. 6 oder „nie“). 0: nur Artikel mit Schlagwort werden geprüft.
FUNDUS_PRUEFINTERVALL=12

# ---------- Sicherung ----------
# Uhrzeit der nächtlichen Sicherung (HH:MM, Zeitzone aus TZ) und Aufbewahrung in Tagen.
SICHERUNG_UHRZEIT=02:30
SICHERUNG_TAGE=14

# Kopie außer Haus: Jede Sicherung geht zusätzlich per rclone auf ein zweites System und wird dort geprüft.
# Das Ziel steht komplett in einer Zeile (rclone-Verbindungszeichenkette). Werte mit „:“ oder „,“, also
# jede URL, in einfache Anführungszeichen. Passwörter vorher verschleiern (das ist KEINE Verschlüsselung):
#   docker compose exec sicherung rclone obscure 'GEHEIM'
# Für das Ziel ein eigenes Konto, das nur in diesen einen Ordner schreiben darf.
# Beispiele, genau eines einkommentieren:
# SICHERUNG_KOPIE=:sftp,host=backup.firma.intern,user=wiki,pass=VERSCHLEIERT:fundus
# SICHERUNG_KOPIE=:s3,provider=Other,endpoint='https://s3.anbieter.de',access_key_id=ID,secret_access_key=SCHLUESSEL:bucket/fundus
# SICHERUNG_KOPIE=:webdav,url='https://cloud.firma.de/remote.php/dav/files/wiki',vendor=nextcloud,user=wiki,pass=VERSCHLEIERT:Sicherungen/fundus
# SICHERUNG_KOPIE=:smb,host=nas.firma.intern,user=wiki,pass=VERSCHLEIERT:freigabe/fundus
# Verschlüsselt die Kopie vor dem Hochladen (Inhalt und Dateinamen); das Ziel sieht nur Datensalat.
# Dringend empfohlen. Ohne diesen Schlüssel lässt sich die Kopie nie wieder lesen: in den Passwort-Manager
# und zusätzlich auf Papier. Erzeugen: openssl rand -hex 32
SICHERUNG_KOPIE_SCHLUESSEL=PLATZHALTER_KOPIE_SCHLUESSEL
# Wie lange Kopien draußen liegen bleiben (Tage).
SICHERUNG_KOPIE_TAGE=90
